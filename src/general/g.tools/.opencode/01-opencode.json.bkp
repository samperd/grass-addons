{
    "version": "1.0.0",
    "project": {
        "name": "g.tools",
        "type": "grass-gis-addon",
        "description": "User Addons menu integration - parent container for user-specific GRASS GIS addons. Adds 'User Addons' top-level menu with Addon Extensions section."
    },
    "languages": ["python", "markdown", "bash"],
    "frameworks": {
        "gis": ["grass-gis"],
        "testing": ["pytest", "gunittest"]
    },
    "paths": {
        "root": ".",
        "scripts": "scripts",
        "docs": "doc"
    },
    "tools": {
        "grass_session": "Start GRASS GIS sessions (CLI, GUI, tty)",
        "grass_addon": "Load/unload/manage GRASS addons",
        "grass_menu_xml": "Interact with GRASS wxGUI menu XML files",
        "grass_config": "GRASS configuration management"
    },
    "coding_standards": {
        "python": "PEP 8 + GRASS standards (grass.script as gs, module headers, wxPython GUI)",
        "markdown": "Daring Fireball Markdown",
        "html_documentation": "GRASS compile/install process - generate .html from .md source"
    }
}
